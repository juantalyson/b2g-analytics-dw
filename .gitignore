cat > .gitignore << 'EOF'
# Dados — nunca versionar
data/**
!data/raw/
!data/interim/
!data/processed/
!data/**/.gitkeep
*.csv
*.zip
*.parquet

# Power BI
*.pbix
*.pbit

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Segredos
.env
*.pgpass

# Editor
.vscode/
EOF